# Copy to .env — placeholders only, never commit real secrets.

APP_ENV=development
API_ADDR=:8080
WEB_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://pooli:pooli@localhost:5432/pooli?sslmode=disable
# Unused by Go services today (SSE is in-process). Kept for local compose / future jobs.
REDIS_URL=redis://localhost:6379/0
SESSION_SECRET=dev-session-secret-change-me-32chars
# Reserved — CSRF middleware is not implemented yet; do not rely on this var.
CSRF_SECRET=dev-csrf-secret-change-me-32chars
ADMIN_EMAILS=admin@pooli.local
GIT_SHA=

# Google OAuth (optional). Create a Web client in Google Cloud Console.
# Authorized redirect URI must match GOOGLE_REDIRECT_URL exactly.
# Production example: https://pooli.shop/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to ${PUBLIC_BASE_URL}/api/v1/auth/google/callback when empty.
GOOGLE_REDIRECT_URL=

# Rate engine
# Local/test: mock. Production: nobitex (Wallex fallback, fail-closed — never silent mock).
RATE_PROVIDER=mock
RATE_FALLBACK_PROVIDER=wallex
RATE_POLICY=best_buy
MOCK_USDT_TMN_RATE=126000
# Quote + reservation share one expires_at clock (product default 10m).
QUOTE_TTL_SECONDS=600
# Exact transfers after reservation release are linked as LATE_PAYMENT within this window (default 2h).
LATE_PAYMENT_RECONCILE_WINDOW_SECONDS=7200
RATE_STALE_SECONDS=180
RATE_CACHE_SECONDS=20
RATE_MAX_AGE_SECONDS=60
RATE_PROVIDER_TIMEOUT_SECONDS=5

# Chains (local Nile defaults)
ENABLE_CHAIN_SIMULATOR=true
ENABLE_BSC_WATCHER=true
# Buyer-facing BNB Chain checkout. Default false; production must stay false until WC + watcher verified.
# `make verify` forces true locally for simulator coverage.
ENABLE_BSC_CHECKOUT=false
# Phone OTP SMS provider: mock (local/CI) — production rejects phone OTP while mock
OTP_SMS_PROVIDER=mock
WORKER_HEARTBEAT_STALE_SECONDS=120
TRON_NETWORK=nile
TRONGRID_BASE_URL=https://nile.trongrid.io
TRONGRID_API_KEY=
TRON_USDT_CONTRACT=TXYZopYRdj2D9XRtbG411XZZ3kM5VkAeBf
TRON_CONFIRMATIONS=1
TRON_EXPLORER_TX_URL=https://nile.tronscan.org/#/transaction/%s

# BNB Smart Chain — use an RPC that allows eth_getLogs (public seeds may rate-limit).
# Do not put provider API keys in this file; set BSC_RPC_URL in local .env only.
BSC_NETWORK=mainnet
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_CHAIN_ID=56
BSC_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955
BSC_USDT_DECIMALS=18
BSC_CONFIRMATIONS=15
BSC_EXPLORER_TX_URL=https://bscscan.com/tx/%s
CHAIN_POLL_INTERVAL_SECONDS=8

# Mainnet pilot (see docs/tron-mainnet-pilot.md and docs/bsc-mainnet-pilot.md)
# ENABLE_CHAIN_SIMULATOR=false
# ENABLE_BSC_WATCHER=false
# TRON_NETWORK=mainnet
# TRONGRID_BASE_URL=https://api.trongrid.io
# TRONGRID_API_KEY=
# TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# TRON_CONFIRMATIONS=20
# TRON_EXPLORER_TX_URL=https://tronscan.org/#/transaction/%s
# Pilot override only — do not change the product default above without product sign-off:
# QUOTE_TTL_SECONDS=1800
# ENABLE_BSC_WATCHER=true
# BSC_RPC_URL=

# Telegram (optional — never commit real tokens)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=PooliShopbot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_CONNECT_TOKEN_TTL_SECONDS=600

# Transactional email via Resend (notify.pooli.shop). Human inbox remains support@pooli.shop.
# Keep EMAIL_ENABLED=false until notify.pooli.shop is VERIFIED in Resend and a new key is on the VPS.
# Never commit RESEND_API_KEY. Local/CI: EMAIL_PROVIDER=fake with EMAIL_ENABLED=true.
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM_NAME=Pooli
EMAIL_FROM_ADDRESS=notifications@notify.pooli.shop
EMAIL_REPLY_TO=support@pooli.shop
EMAIL_TIMEOUT_SECONDS=8

# Next.js (NEXT_PUBLIC_* is inlined at next build — rebuild web after changes)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WalletConnect Cloud project id (EVM Pay with Wallet). Optional — without it, EIP-681/QR/copy fallbacks remain.
# Production: set in deploy/hostinger/.env (gitignored) and rebuild pooli-web. Allowlist your site origin in WalletConnect Cloud.
# Never commit the real project id.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
