# Reference vhost for the action gateway (example: agent.pooli.shop).
# Proxy to pooli-action-gateway on 127.0.0.1:8280.
#
#   certbot --nginx -d agent.pooli.shop

server {
    server_name agent.pooli.shop;

    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:8280;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    listen 443 ssl;
    listen [::]:443 ssl;
    ssl_certificate /etc/letsencrypt/live/agent.pooli.shop/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agent.pooli.shop/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = agent.pooli.shop) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    listen [::]:80;
    server_name agent.pooli.shop;
    return 404;
}
