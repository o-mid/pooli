# Reference nginx vhost for pooli.shop (as installed on Hostinger).
# Destination: /etc/nginx/sites-available/pooli.shop
# Do NOT edit kasramadihi.com.
#
# Certbot manages the listen 443 ssl blocks and HTTP→HTTPS redirects.
# After first install of the HTTP-only skeleton, run:
#   certbot --nginx -d pooli.shop -d www.pooli.shop
# and keep the resulting SSL stanzas.

server {
    server_name pooli.shop www.pooli.shop;

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Same-origin /api rewrites are handled by Next; keep buffering off for SSE/polling.
    location /api/ {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
        proxy_read_timeout 120s;
    }

    listen 443 ssl; # managed by Certbot
    listen [::]:443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/pooli.shop/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/pooli.shop/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = www.pooli.shop) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = pooli.shop) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name pooli.shop www.pooli.shop;
    return 404; # managed by Certbot
}
