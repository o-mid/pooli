# Reference nginx vhost for the web app (example: pooli.shop).
# Copy to /etc/nginx/sites-available/ and adjust server_name + static root.
#
# Also install deploy/hostinger/nginx-pooli-upgrade-map.conf as
# /etc/nginx/conf.d/pooli-upgrade-map.conf (once).
#
# Static error page: deploy/hostinger/static/pooli-unavailable.html
# Set `root` below to the directory containing pooli-unavailable.html on your host.

server {
    server_name pooli.shop www.pooli.shop;

    error_page 502 503 504 /pooli-unavailable.html;

    location = /pooli-unavailable.html {
        internal;
        root /srv/pooli/deploy/hostinger/static;
        default_type text/html;
    }

    # SSE and long-lived API streams: bypass Next.js rewrite to avoid buffering/timeouts.
    location /api/v1/merchant/events {
        proxy_pass http://127.0.0.1:8180;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Upgrade $http_upgrade;
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
        proxy_connect_timeout 10s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Same-origin /api rewrites are handled by Next for most routes.
    location /api/ {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
        proxy_read_timeout 120s;
    }

    listen 443 ssl; # managed by Certbot
    listen [::]:443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/pooli.shop/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/pooli.shop/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = www.pooli.shop) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = pooli.shop) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name pooli.shop www.pooli.shop;
    return 404; # managed by Certbot
}
