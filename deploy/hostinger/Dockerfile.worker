# syntax=docker/dockerfile:1
FROM golang:1.23-bookworm AS build
ARG GIT_SHA=unknown
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath \
      -ldflags="-s -w -X github.com/pooli-shop/pooli/internal/buildinfo.GitSHA=${GIT_SHA}" \
      -o /out/chain-worker ./apps/chain-worker

FROM debian:bookworm-slim
ARG GIT_SHA=unknown
ENV GIT_SHA=${GIT_SHA}
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --create-home pooli
WORKDIR /app
COPY --from=build /out/chain-worker /app/chain-worker
USER pooli
ENTRYPOINT ["/app/chain-worker"]
